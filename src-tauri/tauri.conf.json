{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundBox",
  "version": "0.1.1",
  "identifier": "dev.soundbox.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundBox",
        "width": 1400,
        "height": 880
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5Njg4MTJBQjMxRDg4RTkKUldUcGlCMnpLb0ZvdVdCVkJWdU1QYkpkdGJ1VjRkYmp1b3p1Tmk5L096YnQ3b1lJNWV2ZG5LUjkK",
      "endpoints": [
        "https://github.com/Sirsyorrz/SoundBox/releases/latest/download/latest.json"
      ]
    }
  }
}
